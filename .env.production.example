# Profitability / execution safety shield
MAX_QUOTE_AGE_MS=1500
MAX_PRICE_MOVE_BPS=25
MAX_SLIPPAGE_BPS=30
MAX_PRICE_IMPACT_BPS=50
GAS_RESERVE_MULTIPLIER=1.5
MAX_CONSECUTIVE_FAILURES=3
