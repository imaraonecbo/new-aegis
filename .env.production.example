BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8
MIN_PROFIT_USD=5
MIN_PROFIT_BPS=20
RELAYER_FEE_CAP_BPS=5
TARGET_BLOCK_OFFSET=1
SIMULATION_TIMEOUT_MS=5000
