NODE_ENV=production
CHAIN_ID=42161
ENGINE_ENABLED=false
ENGINE_DRY_RUN=true
ARBITRUM_RPC_URL=https://YOUR_PRIVATE_READ_RPC
ARBITRUM_SIMULATION_RPC_URL=https://YOUR_DEDICATED_SIMULATION_RPC
ARBITRUM_PRIVATE_RPC_URL=https://YOUR_ARBITRUM_PRIVATE_SUBMISSION_RPC
ARBITRUM_DEPLOY_RPC=https://YOUR_ARBITRUM_DEPLOY_RPC
EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000
EXECUTOR_PRIVATE_KEY=
