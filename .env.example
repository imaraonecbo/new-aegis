# AegisEngine deployment configuration (Arbitrum One or Arbitrum Sepolia)
# Never commit a real PRIVATE_KEY or API key.
PRIVATE_KEY=
ARBITRUM_MAINNET_RPC=\nARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc\nDEPLOY_CHAIN_ID=421614\nREQUIRE_DEPLOYER_FUNDS=false
ARBISCAN_API_KEY=
RELAYER_ADDRESS=
EIP712_NAME=AegisEngine
EIP712_VERSION=1

# Immutable lender endpoints used by the deployed executor.
AAVE_V3_POOL=0x794a61358D6845594F94dc1DB02A252b5b4814aD
BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8

# Optional initial target/selector configuration.
# A target without a selector remains unusable by _run().
UNISWAP_V2_ROUTER=
UNISWAP_V2_SELECTOR=
UNISWAP_V3_ROUTER=
UNISWAP_V3_SELECTOR=

# Written after deployment.
EXECUTOR_ADDRESS=
DEPLOYMENT_FILE=deployments/arbitrum-sepolia.json
