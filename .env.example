# ==============================================================================
# AegisQuant Enterprise Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide real credentials in production.
# DO NOT commit real keys, secrets or seed phrases to version control.

# Application Server
NODE_ENV=production
PORT=3000

# Security & Authentication (Bank-Grade Standards)
# MUST be generated with: openssl rand -base64 48
JWT_SECRET=replace_with_high_entropy_secret_at_least_32_characters_long
JWT_EXPIRES_IN=15m
SESSION_TIMEOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
BCRYPT_SALT_ROUNDS=12

# Database Connectivity (PostgreSQL 16+)
DATABASE_URL=postgresql://aegis_admin:SECURE_PASSWORD@pg-cluster.internal:5432/aegis_quant_prod?sslmode=verify-full
DATABASE_POOL_MIN=4
DATABASE_POOL_MAX=25

# CORS & Network Whitelisting
CORS_ORIGIN=https://app.aegisquant.finance
ENABLE_HELMET_HSTS=true

# Institutional Risk Ceilings
MAX_POSITION_EXPOSURE_PCT=30.0
MAX_LTV_CEILING_PCT=78.0
MIN_HEALTH_FACTOR_FLOOR=1.15
MAX_DAILY_DRAWDOWN_LIMIT_USD=10000

# EVM Node RPC Providers (Secure Private RPCs)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Sentry Production Error Tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
